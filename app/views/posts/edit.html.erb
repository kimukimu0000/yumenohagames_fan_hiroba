<h1>投稿の編集</h1>

<% if @post.errors.any? %>
  <div role="alert">
    <p>入力内容を確認してください。</p>

    <ul>
      <% @post.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @post do |f| %>
  <div>
    <%= f.label :title, "タイトル" %><br>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :body, "本文" %><br>
    <%= f.text_area :body, rows: 8 %>
  </div>

  <div>
    <%= f.submit "更新する" %>
  </div>
<% end %>

<p>
  <%= link_to "投稿詳細へ戻る", post_path(@post) %>
</p>