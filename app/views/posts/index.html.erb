<h1>投稿一覧</h1>

<% if notice.present? %>
  <p role="status"><%= notice %></p>
<% end %>

<%= form_with url: posts_path, method: :get do |form| %>
  <div>
    <%= form.label :keyword, "キーワード検索" %>
    <%= form.text_field :keyword,
                        value: @keyword,
                        placeholder: "タイトル・本文から検索" %>
  </div>

  <div>
    <%= form.submit "検索する" %>
    <%= link_to "検索を解除", posts_path %>
  </div>
<% end %>

<% if @keyword.present? %>
  <p>「<%= @keyword %>」の検索結果</p>
<% end %>

<p>
  <%= link_to "新規投稿", new_post_path %>
</p>

<% if @posts.any? %>
  <% @posts.each do |post| %>
    <article>
      <h2>
        <%= link_to post.title, post_path(post) %>
      </h2>

      <p>投稿者：<%= post.user.name %></p>
    </article>
  <% end %>
<% else %>
  <% if @keyword.present? %>
    <p>条件に一致する投稿がありません。</p>
  <% else %>
    <p>まだ投稿がありません。</p>
  <% end %>
<% end %>