<h1>ユーザー情報の編集</h1>

<% if @user.errors.any? %>
  <div role="alert">
    <p>入力内容を確認してください。</p>

    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user, url: mypage_path, method: :patch do |f| %>
  <div>
    <%= f.label :name, "名前" %><br>
    <%= f.text_field :name, autocomplete: "name" %>
  </div>

  <div>
    <%= f.label :email_address, "メールアドレス" %><br>
    <%= f.email_field :email_address, autocomplete: "email" %>
  </div>

  <div>
    <%= f.submit "更新する" %>
  </div>
<% end %>

<p>
  <%= link_to "マイページへ戻る", mypage_path %>
</p>