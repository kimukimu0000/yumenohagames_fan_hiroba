<h1>新規登録</h1>

<% if notice.present? %>
  <p role="status"><%= notice %></p>
<% end %>

<% if @user.errors.any? %>
  <div role="alert">
    <p>入力内容を確認してください。</p>

    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user do |f| %>
  <div>
    <%= f.label :name, "名前" %><br>
    <%= f.text_field :name, autocomplete: "name" %>
  </div>

  <div>
    <%= f.label :email_address, "メールアドレス" %><br>
    <%= f.email_field :email_address, autocomplete: "email" %>
  </div>

  <div>
    <%= f.label :password, "パスワード（8文字以上）" %><br>
    <%= f.password_field :password, autocomplete: "new-password" %>
  </div>

  <div>
    <%= f.label :password_confirmation, "パスワード確認" %><br>
    <%= f.password_field :password_confirmation,
                         autocomplete: "new-password" %>
  </div>

  <div>
    <%= f.submit "新規登録" %>
  </div>
<% end %>

<p>
  <%= link_to "ログイン画面へ", new_session_path %>
</p>